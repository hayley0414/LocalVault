# ============================================================
# LocalVault .gitignore
# 目标：坚决防止「加密密码库」和「打包产物 / 缓存」被误传到 GitHub
# ============================================================

# ---- 加密数据库文件（绝对禁止上传！里面是你的全部密码/密钥）----
*.enc
*.enc.tmp
vault.enc
vault.dat
backups/
.localvault/

# ---- 打包产物（PyInstaller）----
dist/
build/
*.spec
__pycache__/
*.pyc
*.pyo

# ---- 缓存 / 临时文件 ----
*.tmp
Thumbs.db
.DS_Store
ehthumbs.db

# ---- Python 虚拟环境 ----
venv/
.venv/
env/
ENV/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
